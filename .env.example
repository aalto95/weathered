# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public key exposed to the browser build
VITE_VAPID_PUBLIC_KEY=

# Shared secret for POST /api/tick — also add it as a GitHub Actions secret
CRON_SECRET=

# Injected automatically by the Vercel Blob integration.
# Run `vercel env pull .env.local` to get it for local development.
BLOB_READ_WRITE_TOKEN=
